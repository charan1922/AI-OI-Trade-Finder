{
  "name": "project-r-simulator",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5001",
    "build": "next build",
    "start": "next start -p 5001",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "db:generate": "prisma generate --config prisma/prisma.config.ts",
    "db:push": "prisma db push --config prisma/prisma.config.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "db:pull-prod": "node scripts/db-pull-prod.mjs",
    "db:pull-prod:full": "node scripts/db-pull-prod.mjs --full",
    "verify:auto-target-stream": "tsx scripts/verify-auto-target-stream.ts",
    "verify:auto-trade-store": "tsx scripts/verify-auto-trade-store.ts",
    "auto:target-audit": "node scripts/auto-target-audit.mjs --amount=1100 --basis=per_trade",
    "auto:entry-filter-audit": "tsx scripts/auto-entry-filter-audit.ts",
    "verify:r-factor-v2": "tsx scripts/verify-rfactor-v2.ts",
    "verify:user-access": "tsx scripts/verify-user-access.ts",
    "verify:user-access-store": "tsx scripts/verify-user-access-store.ts",
    "verify:r-factor-v2-store": "tsx scripts/verify-rfactor-v2-store.ts",
    "eval:r-factor-v2": "tsx scripts/eval-rfactor-v2.ts",
    "box:start": "node scripts/box.mjs start",
    "box:stop": "node scripts/box.mjs stop",
    "box:status": "node scripts/box.mjs status"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-popover": "^1.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fyers-api-v3": "^2.4.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "openai": "^7.45.1",
    "otpauth": "^9.5.2",
    "playwright": "^1.64.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "swagger-ui-dist": "^5.34.0",
    "tailwind-merge": "^3.7.0",
    "trading-signals": "^8.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
