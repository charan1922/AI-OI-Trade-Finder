# Keep the build context small and free of local state / secrets.
.git
node_modules
.next
dist
out

# Local persistent state — the DB, token caches and parquet live on the Railway
# volume at runtime, never baked into the image (also keeps secrets out).
data

# Secrets — set these as Railway service variables instead.
.env
.env.*
*.local

# Dev-only standalone tooling (tsx scripts, replay harness). Not part of the
# deployable app, and some import dev-only modules (e.g. dotenv) that aren't
# dependencies — keeping them out of the image avoids type-checking them in the
# production `next build`. Nothing in app/lib/components imports from here.
scripts

# Docs, notes, design vaults and validation journals — referenced only in code
# COMMENTS, never imported/read at runtime (verified: no app/lib/components
# import from them). Keeping them out of the build context shrinks the image and
# speeds the build — R-Obsidian alone is ~18 MB of markdown that was being copied
# across the Windows↔WSL mount on every local build.
R-Obsidian
derive-r
openspec
tracking
okf
autotrade-aicommentary

# Logs, OS cruft, scratch
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
*_test.ts
