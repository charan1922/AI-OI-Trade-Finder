generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Watchlist {
  id         Int      @id @default(autoincrement())
  symbol     String
  exchange   String   @default("NSE")
  segment    String   @default("EQ")
  securityId String?
  addedAt    DateTime @default(now())

  @@unique([symbol, exchange])
  @@map("watchlist")
}

model Activity {
  id        Int      @id @default(autoincrement())
  symbol    String
  exchange  String
  interval  String
  action    String
  rowsCount Int      @default(0)
  status    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([symbol])
  @@map("activity")
}

model MasterContract {
  id         Int       @id @default(autoincrement())
  securityId String
  symbol     String
  exchange   String
  segment    String
  instrument String
  name       String    @default("")
  underlying String?
  expiryDate DateTime?
  lotSize      Float     @default(1)
  strikePrice  Float?
  optionType   String?
  syncDate     String

  @@unique([securityId, segment])
  @@index([exchange, symbol])
  @@index([segment, instrument, underlying])
  @@index([underlying, expiryDate, optionType, strikePrice])
  @@index([syncDate])
  @@map("master_contracts")
}

model BhavcopyDay {
  id          Int    @id @default(autoincrement())
  date        String
  symbol      String
  eqVolume      Float  @default(0)
  eqTurnover    Float  @default(0)
  eqOpen        Float  @default(0)
  eqHigh        Float  @default(0)
  eqLow         Float  @default(0)
  eqClose       Float  @default(0)
  /// NSE official VWAP close (ClsPric). eqLastPrice below is the final traded
  /// price (LastPric) — they differ on a late spike; movers UI uses last price.
  eqLastPrice   Float  @default(0)
  eqTrades      Int    @default(0)
  eqDeliveryQty Float  @default(0)
  eqDeliveryPct Float  @default(0)
  futVolume   Float  @default(0)
  futOi       Float  @default(0)
  futOiChange Float  @default(0)
  futTurnover Float  @default(0)
  futTrades   Int    @default(0)
  optVolume   Float  @default(0)
  optOi       Float  @default(0)
  optTurnover Float  @default(0)
  optTrades   Int    @default(0)
  ceVolume    Float  @default(0)
  peVolume    Float  @default(0)
  ceTrades    Int    @default(0)
  peTrades    Int    @default(0)

  @@unique([date, symbol])
  @@index([symbol])
  @@index([date])
  @@map("bhavcopy_days")
}

/// Dhan contract IDs preserved per backtest trade (created originally via raw
/// SQL in lib/backtest/backtest-store.ts; declared here so `db push` keeps it).
model TradeContract {
  symbol        String
  date          String
  optionType    String  @map("option_type")
  strike        Float
  eqSecurityId  String? @map("eq_security_id")
  futSecurityId String? @map("fut_security_id")
  futExpiry     String? @map("fut_expiry")
  futLotSize    Float?  @map("fut_lot_size")
  optSecurityId String? @map("opt_security_id")
  optVia        String? @map("opt_via")
  resolvedAt    String  @map("resolved_at")

  @@id([symbol, date, optionType, strike])
  @@map("trade_contracts")
}

/// NSE F&O universe with lot sizes (from "Dhan - Nse Fno Lot Size.csv") and
/// sector classification. sectorSource records provenance: 'tf-map' = the
/// project's existing 207-symbol TradeFinder-derived map; 'inferred' = assigned
/// by matching the company's business to the map's convention for its closest
/// peer (e.g. defence→AUTO like MAZDOCK, liquor→FMCG like UNITDSPR);
/// 'index' = not a stock.
model FnoStock {
  id           Int    @id @default(autoincrement())
  symbol       String @unique
  name         String
  isIndex      Boolean @default(false)
  /// Contract lot sizes for the three published expiry months.
  lotSize      Int
  lotSizeNext  Int    @default(0)
  lotSizeFar   Int    @default(0)
  /// Which months the three lot-size columns refer to (from the CSV header).
  lotMonths    String @default("")
  sector       String
  sectorSource String
  /// Trade band by lot size: 'core' (250-1500) | 'extended' (150-249/1501-2500)
  /// | 'avoid' (<150 / >2500). Persisted at seed time; logic in lib/trade-band.ts.
  tradeBand    String @default("")
  syncedAt     String @default("")

  @@index([sector])
  @@index([tradeBand])
  @@map("fno_stocks")
}

/// Numeric definition of the trade bands — a queryable lookup so the lot-size
/// ranges behind fno_stocks.tradeBand are visible in the DB. Populated by
/// scripts/seed-fno-stocks.mjs from lib/trade-band.ts. "extended" has two rows
/// (the two shoulders around Core). Find a band for lot N with:
///   SELECT band FROM trade_band_ranges WHERE N BETWEEN lotMin AND lotMax
model TradeBandRange {
  band   String
  label  String
  lotMin Int
  lotMax Int
  note   String @default("")

  @@id([band, lotMin])
  @@map("trade_band_ranges")
}

/// Manual, hand-curated band overrides (e.g. force specific symbols to 'avoid'
/// regardless of lot size). Applied to fno_stocks.tradeBand at seed time so it
/// survives re-seeding. NOT auto-populated — only edited deliberately.
model BandOverride {
  symbol String @id
  band   String
  note   String @default("")

  @@map("band_overrides")
}

model TfSnapshot {
  id        Int    @id @default(autoincrement())
  date      String
  symbol    String
  rFactor   Float
  ltp       Float  @default(0)
  prevClose Float  @default(0)
  pctChange Float  @default(0)

  @@unique([date, symbol])
  @@index([date])
  @@map("tf_snapshots")
}

/// Intraday futures-OI snapshots powering the Live Urgency time-series (created
/// at runtime via raw SQL in lib/signals/oi-intraday.ts; declared here so
/// `db push` keeps it). One date-partitioned table keyed by (symbol, date,
/// bucketTs) — bucketTs is the epoch-second wall clock floored to a 60s grid.
model OiIntraday {
  symbol        String
  date          String
  bucketTs      Int
  capturedAt    String
  ltp           Float  @default(0)
  futOi         Float  @default(0)
  futOiAvg20d   Float  @default(0)
  oiLevel       Float  @default(0)
  futTurnover   Float  @default(0)
  changePctOpen Float?
  spreadPct     Float?
  imbalance     Float?

  @@id([symbol, date, bucketTs])
  @@index([date, symbol])
  @@map("oi_intraday")
}

/// Live 5-minute intraday candles, persisted so the series is available at any
/// time (R-Factor breakout/range, charts, an AI agent) without re-hitting Dhan.
/// Same lazy-CREATE + mirrored-model convention as OiIntraday. Keyed by
/// (symbol, date, bucketTs); bucketTs is the bar-START epoch second floored to a
/// 300s (5-min) grid. `source` = 'rest' (authoritative Dhan backfill) or 'agg'
/// (aggregated from live quote polls; OHLC only, volume 0 until backfilled).
model IntradayCandle {
  symbol    String
  date      String
  bucketTs  Int
  open      Float  @default(0)
  high      Float  @default(0)
  low       Float  @default(0)
  close     Float  @default(0)
  volume    Float  @default(0)
  source    String @default("agg")
  updatedAt String

  @@id([symbol, date, bucketTs])
  @@index([date, symbol])
  @@map("intraday_candles")
}

/// Fyers live 5-min candles (equity + current-month stock future) for the F&O
/// movers universe, accumulated per day (created at runtime via raw SQL in
/// lib/fyers/candle-store.ts; declared here so `db push` keeps it). Only
/// today's rows are retained (pruned each poller cycle). `oi` is live futures
/// OI attached to the bucket that was current at sample time (FUT rows only,
/// 0 elsewhere — Fyers history has no OI). bucketTs = bar-START epoch seconds
/// on a 300s grid, as returned by the Fyers history API.
model FyersCandle {
  symbol     String
  instrument String // 'EQ' | 'FUT'
  date       String
  bucketTs   Int
  open       Float  @default(0)
  high       Float  @default(0)
  low        Float  @default(0)
  close      Float  @default(0)
  volume     Float  @default(0)
  oi         Float  @default(0)
  updatedAt  String

  @@id([symbol, instrument, date, bucketTs])
  @@index([date, symbol, instrument])
  @@map("fyers_candles")
}

model OptionTrade {
  id            Int      @id @default(autoincrement())
  date          String
  symbol        String
  optionType    String
  strikePrice   Float
  expiryDate    String
  securityId    String
  entryPrice    Float
  exitPrice     Float?
  quantity      Int
  lotSize       Int
  spotAtEntry   Float
  grossPnl      Float?
  charges       Float?
  netPnl        Float?
  entryTime     String
  exitTime      String?
  exitReason    String?
  rFactor       Float
  adx           Float?
  aiRationale   String
  aiConfidence  Float
  paperTrade    Boolean  @default(true)
  orderId       String?
  status        String   @default("OPEN")

  @@index([date])
  @@index([symbol])
  @@map("option_trades")
}

model Settings {
  id              Int     @id @default(1)
  dhanClientId    String  @default("")
  dhanAccessToken String  @default("")
  batchSize       Int     @default(10)
  rateLimitMs     Int     @default(250)
  defaultRange    String  @default("30")
  theme           String  @default("dark")
  chartHeight     Int     @default(450)
  autoRefresh     Boolean @default(true)
  showTooltips    Boolean @default(true)

  @@map("settings")
}
