generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model MasterContract {
  id         Int       @id @default(autoincrement())
  securityId String
  symbol     String
  exchange   String
  segment    String
  instrument String
  name       String    @default("")
  underlying String?
  expiryDate DateTime?
  lotSize      Float     @default(1)
  strikePrice  Float?
  optionType   String?
  syncDate     String

  @@unique([securityId, segment])
  @@index([exchange, symbol])
  @@index([segment, instrument, underlying])
  @@index([underlying, expiryDate, optionType, strikePrice])
  @@index([syncDate])
  @@map("master_contracts")
}

model BhavcopyDay {
  id          Int    @id @default(autoincrement())
  date        String
  symbol      String
  eqVolume      Float  @default(0)
  eqTurnover    Float  @default(0)
  eqOpen        Float  @default(0)
  eqHigh        Float  @default(0)
  eqLow         Float  @default(0)
  eqClose       Float  @default(0)
  /// NSE official VWAP close (ClsPric). eqLastPrice below is the final traded
  /// price (LastPric) — they differ on a late spike; movers UI uses last price.
  eqLastPrice   Float  @default(0)
  eqTrades      Int    @default(0)
  eqDeliveryQty Float  @default(0)
  eqDeliveryPct Float  @default(0)
  futVolume   Float  @default(0)
  futOi       Float  @default(0)
  futOiChange Float  @default(0)
  futTurnover Float  @default(0)
  futTrades   Int    @default(0)
  optVolume   Float  @default(0)
  optOi       Float  @default(0)
  optTurnover Float  @default(0)
  optTrades   Int    @default(0)
  ceVolume    Float  @default(0)
  peVolume    Float  @default(0)
  ceTrades    Int    @default(0)
  peTrades    Int    @default(0)

  @@unique([date, symbol])
  @@index([symbol])
  @@index([date])
  @@map("bhavcopy_days")
}

/// Dhan contract IDs preserved per backtest trade (created originally via raw
/// SQL in lib/backtest/backtest-store.ts; declared here so `db push` keeps it).
model TradeContract {
  symbol        String
  date          String
  optionType    String  @map("option_type")
  strike        Float
  eqSecurityId  String? @map("eq_security_id")
  futSecurityId String? @map("fut_security_id")
  futExpiry     String? @map("fut_expiry")
  futLotSize    Float?  @map("fut_lot_size")
  optSecurityId String? @map("opt_security_id")
  optVia        String? @map("opt_via")
  resolvedAt    String  @map("resolved_at")

  @@id([symbol, date, optionType, strike])
  @@map("trade_contracts")
}

/// NSE F&O universe with lot sizes (from "Dhan - Nse Fno Lot Size.csv") and
/// sector classification. sectorSource records provenance: 'tf-map' = the
/// project's existing 207-symbol TradeFinder-derived map; 'inferred' = assigned
/// by matching the company's business to the map's convention for its closest
/// peer (e.g. defence→AUTO like MAZDOCK, liquor→FMCG like UNITDSPR);
/// 'index' = not a stock.
model FnoStock {
  id           Int    @id @default(autoincrement())
  symbol       String @unique
  name         String
  isIndex      Boolean @default(false)
  /// Contract lot sizes for the three published expiry months.
  lotSize      Int
  lotSizeNext  Int    @default(0)
  lotSizeFar   Int    @default(0)
  /// Which months the three lot-size columns refer to (from the CSV header).
  lotMonths    String @default("")
  sector       String
  sectorSource String
  /// Trade band by lot size: 'core' (250-1500) | 'extended' (150-249/1501-2500)
  /// | 'avoid' (<150 / >2500). Persisted at seed time; logic in lib/trade-band.ts.
  tradeBand    String @default("")
  syncedAt     String @default("")

  @@index([sector])
  @@index([tradeBand])
  @@map("fno_stocks")
}

/// Numeric definition of the trade bands — a queryable lookup so the lot-size
/// ranges behind fno_stocks.tradeBand are visible in the DB. Populated by
/// scripts/seed-fno-stocks.mjs from lib/trade-band.ts. "extended" has two rows
/// (the two shoulders around Core). Find a band for lot N with:
///   SELECT band FROM trade_band_ranges WHERE N BETWEEN lotMin AND lotMax
model TradeBandRange {
  band   String
  label  String
  lotMin Int
  lotMax Int
  note   String @default("")

  @@id([band, lotMin])
  @@map("trade_band_ranges")
}

/// Manual, hand-curated band overrides (e.g. force specific symbols to 'avoid'
/// regardless of lot size). Applied to fno_stocks.tradeBand at seed time so it
/// survives re-seeding. NOT auto-populated — only edited deliberately.
model BandOverride {
  symbol String @id
  band   String
  note   String @default("")

  @@map("band_overrides")
}

model TfSnapshot {
  id        Int    @id @default(autoincrement())
  date      String
  symbol    String
  rFactor   Float
  ltp       Float  @default(0)
  prevClose Float  @default(0)
  pctChange Float  @default(0)

  @@unique([date, symbol])
  @@index([date])
  @@map("tf_snapshots")
}

/// Intraday futures-OI snapshots powering the Live Urgency time-series (created
/// at runtime via raw SQL in lib/signals/oi-intraday.ts; declared here so
/// `db push` keeps it). One date-partitioned table keyed by (symbol, date,
/// bucketTs) — bucketTs is the epoch-second wall clock floored to a 60s grid.
model OiIntraday {
  symbol        String
  date          String
  bucketTs      Int
  capturedAt    String
  ltp           Float  @default(0)
  futOi         Float  @default(0)
  futOiAvg20d   Float  @default(0)
  oiLevel       Float  @default(0)
  futTurnover   Float  @default(0)
  changePctOpen Float?
  spreadPct     Float?
  imbalance     Float?
  optShare      Float?
  premValueCr   Float?

  @@id([symbol, date, bucketTs])
  @@index([date, symbol])
  @@map("oi_intraday")
}

/// App-wide feature toggles flipped from the /config page (created at runtime
/// via raw SQL in lib/config/feature-toggles.ts; declared here so `db push`
/// keeps it). The registry + defaults live in that file; this table only stores
/// overrides. value is 0/1.
model FeatureToggle {
  key       String @id
  value     Int
  updatedAt String

  @@map("feature_toggles")
}

/// Fyers live 5-min candles (equity + current-month stock future) for the
/// tradeable F&O universe — all non-index, non-'avoid'-band fno_stocks names
/// plus explicit enrollments (created at runtime via raw SQL in
/// lib/fyers/candle-store.ts; declared here so `db push` keeps it). Only
/// today's rows are retained (pruned each poller cycle). `oi` is live futures
/// OI attached to the bucket that was current at sample time (FUT rows only,
/// 0 elsewhere — Fyers history has no OI). bucketTs = bar-START epoch seconds
/// on a 300s grid, as returned by the Fyers history API.
model FyersCandle {
  symbol     String
  instrument String // 'EQ' | 'FUT'
  date       String
  bucketTs   Int
  open       Float  @default(0)
  high       Float  @default(0)
  low        Float  @default(0)
  close      Float  @default(0)
  volume     Float  @default(0)
  oi         Float  @default(0)
  /// Depth-snapshot extras from the same getMarketDepth call as `oi` (FUT
  /// current bucket only; NULL on EQ rows and unattached buckets):
  /// pdoi = previous-day OI, oiPct = Fyers' OI %-change, atp = day VWAP
  /// (turnover ≈ atp × dayVolume), buy/sellQty = resting book totals,
  /// futLtp = the future's own LTP (basis vs equity close).
  pdoi       Float?
  oiPct      Float?
  atp        Float?
  dayVolume  Float?
  buyQty     Float?
  sellQty    Float?
  futLtp     Float?
  /// NSE's combined OI %-change (futures + options) from the oi-spurts feed,
  /// stored verbatim — the one non-Fyers column (matches /nse/movers).
  nseOiPct   Float?
  updatedAt  String

  @@id([symbol, instrument, date, bucketTs])
  @@index([date, symbol, instrument])
  @@map("fyers_candles")
}

/// Persisted /trade-suggest calls (created at runtime via raw SQL in
/// lib/trade-suggest/store.ts; declared here so `db push` keeps it). One row
/// per (date, symbol, optionType): the FIRST sighting fixes suggestedAt and
/// spotAtSuggest (what gets scored); re-suggestions bump timesSeen and refresh
/// the latest signal readings. Outcome columns are filled same-day by
/// lib/trade-suggest/review.ts from fyers_candles (spot-terms move after the
/// call: max favorable / adverse excursion + close).
model TradeSuggestion {
  date          String
  symbol        String
  optionType    String // 'CE' | 'PE'
  strike        Float   @default(0)
  expiryDate    String  @default("")
  spotAtSuggest Float   @default(0)
  slSpot        Float?
  targetSpot    Float?
  lotSize       Int     @default(0)
  optSecurityId String  @default("")
  sector        String  @default("")
  rFactor       Float   @default(0)
  confidence    Float   @default(0)
  oiLevel       Float   @default(0)
  oiUrgency     Float?
  score            Float   @default(0)
  rank             Int     @default(0)
  reasons          String  @default("[]")
  premiumAtSuggest Float?
  premiumSl        Float?
  premiumTarget    Float?
  suggestedAt      String
  lastSeenAt       String
  timesSeen        Int     @default(1)
  maxUpPct      Float?
  maxDownPct    Float?
  closePct      Float?
  outcomeAt     String?

  @@id([date, symbol, optionType])
  @@index([date])
  @@map("trade_suggestions")
}

/// AI prompt version history (created at runtime via raw SQL in
/// lib/prompts/store.ts; declared here so `db push` keeps it). One row per
/// distinct prompt text per key ('trade-commentary', 'auto-trader'); recorded
/// automatically whenever a generation path runs with changed prompt text.
/// Read-only history — the code stays the source of truth for what runs.
model PromptVersion {
  key       String
  version   Int
  text      String
  createdAt String

  @@id([key, version])
  @@map("prompt_versions")
}

/// Registered users + subscription fields — every Google account that signs in
/// (created at runtime via raw SQL in lib/auth/users.ts; declared here so
/// `db push` keeps it). Owner email → admin/owner; everyone else registers as
/// viewer/trial (read-only). Enforcement stays in proxy.ts/rbac.ts for now;
/// the future billing step flips role resolution to read this table.
model AppUser {
  email              String  @id
  name               String?
  image              String?
  role               String  @default("viewer")
  plan               String  @default("trial")
  status             String  @default("active")
  subscriptionEndsAt String?
  createdAt          String
  lastSeenAt         String

  @@map("app_users")
}

/// Auto-trade runtime settings — mode/broker/AI/kill-switch/caps flipped from
/// the /auto-trade page (created at runtime via raw SQL in
/// lib/auto-trade/settings.ts; declared here so `db push` keeps it). The
/// registry + defaults live in that file; this table only stores overrides.
model AutoTradeSetting {
  key       String @id
  value     String
  updatedAt String

  @@map("auto_trade_settings")
}

/// One AI-driven position lifecycle: proposal → (approval) → fill → managed →
/// exit (created at runtime via raw SQL in lib/auto-trade/store.ts; declared
/// here so `db push` keeps it). Premium fields are ₹/share; realizedPnlRupees
/// = (exitFill − entryFill) × lotSize × lots, set only when both fills known.
model AutoTrade {
  id                Int     @id @default(autoincrement())
  date              String
  symbol            String
  direction         String
  optionType        String
  strike            Float
  expiryDate        String
  lotSize           Int
  lots              Int
  optSecurityId     String
  mode              String
  broker            String
  status            String
  entrySpot         Float
  slSpot            Float?
  targetSpot        Float?
  entryPremium      Float
  slPremium         Float
  targetPremium     Float
  entryFillPremium  Float?
  exitFillPremium   Float?
  exitReason        String?
  aiReasonEntry     String
  aiReasonExit      String?
  realizedPnlRupees Float?
  // Would-have figures for failed entries, backfilled from real candles —
  // display-only, never counted in realized P&L or exposure.
  shadowEntryPremium Float?
  shadowExitPremium  Float?
  shadowExitReason   String?
  shadowPnlRupees    Float?
  proposedAt        String
  openedAt          String?
  closedAt          String?
  updatedAt         String

  @@index([date])
  @@map("auto_trades")
}

/// Every order sent to any execution venue (paper/fyers/dhan), idempotency-
/// keyed so a retry can never double-fire (created at runtime via raw SQL in
/// lib/auto-trade/store.ts; declared here so `db push` keeps it).
model AutoOrder {
  id            Int     @id @default(autoincrement())
  tradeId       Int
  idemKey       String  @unique
  broker        String
  mode          String
  side          String
  qtyUnits      Int
  correlationId String?
  brokerOrderId String?
  status        String
  avgFillPrice  Float?
  error         String?
  reconcileAttempts Int @default(0)
  lastReconciledAt String?
  createdAt     String
  updatedAt     String

  @@index([tradeId])
  @@unique([broker, correlationId])
  @@map("auto_orders")
}

/// Append-only audit of every auto-trade pass — AI decisions with their full
/// tool trace, guard actions, approval events (created at runtime via raw SQL
/// in lib/auto-trade/store.ts; declared here so `db push` keeps it).
model AutoDecision {
  id               Int     @id @default(autoincrement())
  date             String
  at               String
  pass             String
  provider         String?
  model            String?
  summary          String
  toolTrace        String  @default("[]")
  promptTokens     Int?
  completionTokens Int?

  @@index([date])
  @@map("auto_decisions")
}

/// Permanent EOD copy of the /live "Live Urgency" board (created at runtime via
/// raw SQL in lib/signals/live-urgency-eod.ts; declared here so `db push` keeps
/// it). One row per (date, symbol) — the first post-market capture of a session
/// wins and is never overwritten (dayHigh/dayLow come from fyers_candles, which
/// only retains TODAY, so a later re-capture for an older date must not clobber
/// the good first write with nulls). bid/ask/hasDepth aren't stored — the order
/// book no longer exists at EOD, same as the live closing-snapshot response.
model LiveUrgencyEod {
  date               String
  symbol             String
  ltp                Float   @default(0)
  changePctOpen      Float?
  spreadPct          Float?
  imbalance          Float?
  futOi              Float?
  oiLevel            Float?
  turnover           Float?
  dayHigh            Float?
  dayLow             Float?
  sessionOiChangePct Float?
  oiVelocity         Float?
  oiAccel            Float?
  oiUrgency          Float?
  rFactor            Float?
  rFactorBias        String?
  rFactorConfidence  Float?
  rFactorAfterEntry  Int?
  rFactors           String  @default("[]")
  breakout           String?
  nseOiPct           Float?
  nseOiSlope30m      Float?
  capturedAt         String

  @@id([date, symbol])
  @@index([date])
  @@map("live_urgency_eod")
}

/// Rank tracker — per-5-min leaderboard rank of each F&O name in each NSE pulse
/// feed (the "running race"). Runtime-created in lib/signals/rank-tracker.ts;
/// mirrored here so `db push` on a fresh volume keeps it. Retention: 20 sessions.
model RankSnapshot {
  date       String
  bucketTs   Int
  feed       String
  symbol     String
  rank       Int
  value      Float?
  fullUniverse Int?
  capturedAt String

  @@id([date, bucketTs, feed, symbol])
  @@index([date, feed, bucketTs])
  @@map("rank_snapshots")
}

/// Cross-process singleton lease used during rolling deploy overlap.
model RuntimeLease {
  name      String @id
  owner     String
  expiresAt Int
  updatedAt String

  @@map("runtime_leases")
}

